---
// A live world map: where the sun is up, where it is twilight, and where it is night, right now,
// with the masajid in the network marked and the latest adhan for each prayer.
import land from '../data/land.json';
import masajidFile from '../content/masajid.json';
const masajid = masajidFile.masajid;
import copy from '../content/landing.json';
const s = copy.sun;
const rows = land.rows.length;
const pins = masajid.filter((m) => typeof m.lat === 'number' && typeof m.lng === 'number');
const x = (lon: number) => ((lon + 180) / 360) * 100;
const y = (lat: number) => ((land.latMax + land.step / 2 - lat) / (rows * land.step)) * 100;
---
<div class="sunmap" data-sunmap data-land={JSON.stringify(land)} style={`--ratio:${land.cols}/${rows}`}>
  <div class="map" role="img" aria-label={s.mapLabel}>
    <canvas data-canvas></canvas>
    <span class="sun" data-sun aria-hidden="true"></span>
    {pins.map((m, i) => (
      <span class="pin" style={`left:${x(m.lng)}%;top:${y(m.lat)}%;--i:${i}`} aria-hidden="true">
        <span class="tip">{m.name}<small>{m.city}, {m.country}{m.placeholder && ' · placeholder'}</small></span>
      </span>
    ))}
  </div>
  <ul class="legend" role="list">
    <li><i class="k-day"></i>{s.legendDay}</li>
    <li><i class="k-tw"></i>{s.legendTwilight}</li>
    <li><i class="k-night"></i>{s.legendNight}</li>
    <li><i class="k-pin"></i>{s.legendMasjid}</li>
  </ul>

  <div class="adhan">
    <p class="adhan-head"><span class="live"><i></i>{s.liveLabel}</span> {s.liveTitle}</p>
    <ol class="adhan-list" role="list" data-adhan data-ago={s.ago} data-now={s.justNow} data-local={s.local}>
      {['Fajr', 'Dhuhr', 'Asr', 'Maghrib', 'Isha'].map((p) => <li><span class="p">{p}</span><span class="c">&nbsp;</span><span class="t">&nbsp;</span></li>)}
    </ol>
    <p class="note">{s.note}</p>
  </div>
</div>

<script>
  import { subsolar, altitude, latestAdhans } from '../lib/sun';
  import cities from '../data/cities.json';

  const root = document.querySelector<HTMLElement>('[data-sunmap]');
  if (root) {
    const land = JSON.parse(root.dataset.land!) as { step: number; latMax: number; cols: number; rows: string[] };
    const dots: [number, number, number, number][] = []; // col, row, lat, lon
    land.rows.forEach((hex, r) => {
      let bits = '';
      for (const h of hex) bits += parseInt(h, 16).toString(2).padStart(4, '0');
      for (let c = 0; c < land.cols; c++) if (bits[c] === '1') dots.push([c, r, land.latMax - r * land.step, -180 + land.step / 2 + c * land.step]);
    });
    const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    const sunEl = root.querySelector<HTMLElement>('[data-sun]')!;
    const ctx = canvas.getContext('2d')!;
    const rows = land.rows.length;

    // gold (day) → green-gold (twilight) → faint (night)
    const colour = (a: number) => {
      if (a > 0) { const k = Math.min(1, a / 40); return `rgba(${240 - 20 * k},${222 - 30 * k},${190 - 45 * k},${0.8 + 0.2 * k})`; }
      if (a > -18) { const k = (a + 18) / 18; return `rgba(${70 + 110 * k},${130 + 40 * k},${115 + 5 * k},${0.22 + 0.4 * k})`; }
      return 'rgba(255,255,255,0.075)';
    };

    const draw = () => {
      const w = canvas.clientWidth, h = canvas.clientHeight;
      if (!w) return;
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);
      const sun = subsolar(new Date());
      const cw = w / land.cols, ch = h / rows;
      const r = Math.max(0.9, Math.min(cw, ch) * 0.34);
      const sx = ((sun.lon + 180) / 360) * w, sy = ((land.latMax + land.step / 2 - sun.lat) / (rows * land.step)) * h;
      const glow = ctx.createRadialGradient(sx, sy, 0, sx, sy, w * 0.28);
      glow.addColorStop(0, 'rgba(231,214,184,0.22)'); glow.addColorStop(1, 'rgba(231,214,184,0)');
      ctx.fillStyle = glow; ctx.fillRect(0, 0, w, h);
      for (const [c, rr, lat, lon] of dots) {
        const a = altitude(lat, lon, sun);
        ctx.fillStyle = colour(a);
        ctx.beginPath(); ctx.arc((c + 0.5) * cw, (rr + 0.5) * ch, a > 0 ? r * 1.12 : r, 0, Math.PI * 2); ctx.fill();
      }
      sunEl.style.left = `${(sx / w) * 100}%`; sunEl.style.top = `${(sy / h) * 100}%`;
    };

    const list = root.querySelector<HTMLElement>('[data-adhan]')!;
    const fmtAgo = (mins: number) => {
      if (mins < 2) return list.dataset.now!;
      const t = mins >= 60 ? `${Math.floor(mins / 60)} h ${mins % 60}` : String(mins);
      return list.dataset.ago!.replace('{m}', t);
    };
    const tick = () => {
      const now = new Date();
      const latest = latestAdhans(now, cities);
      const newest = latest.reduce((a, b) => (b.at > a.at ? b : a), latest[0]);
      list.querySelectorAll('li').forEach((li) => {
        const name = li.querySelector('.p')!.textContent;
        const row = latest.find((l) => l.prayer === name);
        if (!row) return;
        const mins = Math.max(0, Math.round((now.getTime() - row.at.getTime()) / 60000));
        const local = row.at.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: row.city.tz });
        li.querySelector('.c')!.textContent = `${row.city.name}, ${row.city.country}`;
        li.querySelector('.t')!.textContent = `${local} ${list.dataset.local} · ${fmtAgo(mins)}`;
        li.classList.toggle('newest', row === newest);
      });
    };

    let started = false;
    const start = () => {
      if (started) return; started = true;
      draw(); tick();
      setInterval(() => { draw(); tick(); }, 30000);
      new ResizeObserver(draw).observe(canvas);
    };
    // Only do the work once the map is near the screen.
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((e) => { if (e.some((x) => x.isIntersecting)) { start(); io.disconnect(); } }, { rootMargin: '400px' });
      io.observe(root);
    } else start();
  }
</script>

<style>
  .sunmap { position: relative; }
  .map { position: relative; aspect-ratio: var(--ratio); width: 100%; }
  .map canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .sun { position: absolute; width: 18px; height: 18px; margin: -9px 0 0 -9px; border-radius: 50%; background: radial-gradient(circle, #fff7e6 0 35%, var(--gold) 60%, transparent 72%); box-shadow: 0 0 22px 8px rgba(231, 214, 184, 0.5); pointer-events: none; }
  .pin { position: absolute; width: 22px; height: 22px; margin: -11px 0 0 -11px; border-radius: 50%; cursor: default; }
  .pin::before { content: ''; position: absolute; inset: 7px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 2px var(--green-night), 0 0 14px rgba(207, 176, 131, 0.9); }
  .pin::after { content: ''; position: absolute; inset: 3px; border-radius: 50%; border: 1.5px solid var(--gold); opacity: 0; }
  @media (prefers-reduced-motion: no-preference) { .pin::after { animation: ping 3.2s cubic-bezier(0.2, 0.6, 0.3, 1) infinite; animation-delay: calc(var(--i) * 0.37s); } }
  @keyframes ping { 0% { transform: scale(0.6); opacity: 0.95; } 80%, 100% { transform: scale(2.6); opacity: 0; } }
  .tip { position: absolute; left: 50%; bottom: calc(100% + 8px); transform: translate(-50%, 4px); min-width: max-content; padding: 8px 12px; border-radius: 10px; background: var(--white); color: var(--green); font-weight: 700; font-size: 0.85rem; line-height: 1.3; box-shadow: 0 14px 30px -12px rgba(0, 0, 0, 0.5); opacity: 0; visibility: hidden; transition: opacity 0.2s, transform 0.2s var(--ease), visibility 0.2s; z-index: 2; }
  .tip small { display: block; font-weight: 500; color: var(--ink-soft); font-size: 0.78rem; }
  .pin:hover .tip { opacity: 1; visibility: visible; transform: translate(-50%, 0); }

  .legend { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 18px; font-size: 0.84rem; color: rgba(255, 255, 255, 0.7); }
  .legend li { display: inline-flex; align-items: center; gap: 8px; }
  .legend i { width: 9px; height: 9px; border-radius: 50%; }
  .k-day { background: var(--gold-soft); }
  .k-tw { background: rgba(130, 155, 120, 0.85); }
  .k-night { background: rgba(255, 255, 255, 0.16); }
  .k-pin { background: var(--gold); box-shadow: 0 0 0 2px rgba(207, 176, 131, 0.35); }

  .adhan { margin-top: clamp(28px, 4vw, 44px); padding: clamp(20px, 3vw, 30px); border: 1px solid var(--line-light); border-radius: var(--radius); background: rgba(0, 35, 30, 0.45); }
  .adhan-head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; font-weight: 600; color: rgba(255, 255, 255, 0.86); }
  .live { display: inline-flex; align-items: center; gap: 7px; padding: 3px 10px 3px 8px; border-radius: 999px; background: rgba(207, 176, 131, 0.16); color: var(--gold-soft); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
  .live i { width: 7px; height: 7px; border-radius: 50%; background: #f0c674; box-shadow: 0 0 0 0 rgba(240, 198, 116, 0.7); }
  @media (prefers-reduced-motion: no-preference) { .live i { animation: live 1.8s infinite; } }
  @keyframes live { 0% { box-shadow: 0 0 0 0 rgba(240, 198, 116, 0.7); } 100% { box-shadow: 0 0 0 9px rgba(240, 198, 116, 0); } }
  .adhan-list { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; margin-top: 18px; }
  .adhan-list li { padding: 16px; border-radius: 14px; background: rgba(255, 255, 255, 0.045); border: 1px solid transparent; transition: background-color 0.4s, border-color 0.4s; min-width: 0; }
  .adhan-list li.newest { background: rgba(207, 176, 131, 0.13); border-color: rgba(207, 176, 131, 0.45); }
  .adhan-list .p { display: block; font-family: var(--display); font-size: 1.35rem; font-weight: 650; color: var(--gold-soft); }
  .adhan-list .c { display: block; margin-top: 6px; font-weight: 650; color: var(--white); line-height: 1.3; }
  .adhan-list .t { display: block; margin-top: 4px; font-size: 0.82rem; color: rgba(255, 255, 255, 0.62); line-height: 1.35; }
  .note { margin-top: 14px; font-size: 0.8rem; color: rgba(255, 255, 255, 0.5); }
  @media (max-width: 980px) { .adhan-list { grid-template-columns: 1fr 1fr; } .adhan-list li:last-child { grid-column: 1 / -1; } }
  @media (max-width: 520px) {
    .adhan-list { grid-template-columns: 1fr; gap: 6px; }
    .adhan-list li { display: grid; grid-template-columns: 84px 1fr; column-gap: 12px; padding: 12px 14px; }
    .adhan-list .p { grid-row: span 2; font-size: 1.15rem; align-self: center; }
    .adhan-list .c { margin-top: 0; }
    .tip { display: none; }
    .pin { width: 12px; height: 12px; margin: -6px 0 0 -6px; }
    .pin::before { inset: 3px; box-shadow: 0 0 0 1.5px var(--green-night), 0 0 8px rgba(207, 176, 131, 0.9); }
    .pin::after { inset: 1px; }
    .sun { width: 12px; height: 12px; margin: -6px 0 0 -6px; }
  }
</style>
