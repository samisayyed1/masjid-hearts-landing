---
// The Masjid Hearts mark: the dome of hearts with its crescent finial.
// `animate` assembles it once, row by row, when the page loads.
import dome from '../data/dome.json';
interface Props { animate?: boolean; class?: string }
const { animate = false, class: cls } = Astro.props;
---
<svg class:list={['dome', cls, { 'dome-anim': animate }]} viewBox="4400 4150 12200 12700" aria-hidden="true">
  <g fill="#CFB083">
    {dome.hearts.map((d, i) => <path class="mh-heart" style={`--i:${i}`} d={d} />)}
    <path class="mh-finial" d={dome.finial} />
  </g>
</svg>

<style>
  .dome { display: block; width: 100%; height: auto; }
  @media (prefers-reduced-motion: no-preference) {
    .dome-anim .mh-heart { opacity: 0; animation: mh-dome-heart 0.9s cubic-bezier(0.22, 0.8, 0.26, 1) forwards; animation-delay: calc(0.2s + var(--i) * 28ms); }
    .dome-anim .mh-finial { opacity: 0; animation: mh-dome-finial 1s ease forwards 1.2s; }
  }
  @keyframes mh-dome-heart { from { opacity: 0; } to { opacity: 1; } }
  @keyframes mh-dome-finial { from { opacity: 0; } to { opacity: 1; } }
</style>
