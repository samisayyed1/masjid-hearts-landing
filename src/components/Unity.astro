---
// The giving model as a moving picture: many small monthly gifts → one fund → dozens of masajid.
import dome from '../data/dome.json';
interface Props { label: string; givers: string; fund: string; masajid: string }
const { label, givers, fund, masajid } = Astro.props;

let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const heart = 'M12 21.2C9.6 18.9 3 14.6 3 8.9 3 6 5.1 4 7.6 4c1.9 0 3.4 1.1 4.4 3 1-1.9 2.5-3 4.4-3C18.9 4 21 6 21 8.9c0 5.7-6.6 10-9 12.3z';

function layout(vertical: boolean) {
  const W = vertical ? 400 : 1000, H = vertical ? 700 : 440;
  const c = vertical ? { x: 200, y: 350 } : { x: 500, y: 220 };
  const R = vertical ? 62 : 74;
  const n = vertical ? 14 : 20, m = vertical ? 9 : 13;
  seed = 7;
  const gs = Array.from({ length: n }, (_, i) => {
    const t = (i + 0.5) / n;
    return vertical
      ? { x: 22 + t * 356 + (rnd() - 0.5) * 14, y: 40 + rnd() * 90, s: 0.75 + rnd() * 0.6 }
      : { x: 40 + rnd() * 150, y: 30 + t * 380 + (rnd() - 0.5) * 12, s: 0.75 + rnd() * 0.6 };
  });
  const ms = Array.from({ length: m }, (_, i) => {
    const t = m === 1 ? 0.5 : i / (m - 1);
    return vertical
      ? { x: 30 + t * 340, y: 560 + (i % 2) * 58 + (rnd() - 0.5) * 10, s: i % 2 ? 40 : 46 }
      : { x: 812 + (i % 3) * 64 + (Math.floor(i / 3) % 2) * 26, y: 46 + Math.floor(i / 3) * 78 + (i % 3 === 1 ? 26 : 0), s: i % 2 ? 48 : 56 };
  });
  const inPaths = gs.map((g) => vertical
    ? `M${g.x.toFixed(1)} ${(g.y + 10).toFixed(1)}C${g.x.toFixed(1)} ${(g.y + 120).toFixed(1)} ${c.x} ${c.y - R - 110} ${c.x} ${c.y - R + 4}`
    : `M${(g.x + 12).toFixed(1)} ${g.y.toFixed(1)}C${(g.x + 160).toFixed(1)} ${g.y.toFixed(1)} ${c.x - R - 140} ${c.y} ${c.x - R + 4} ${c.y}`);
  const outPaths = ms.map((d) => vertical
    ? `M${c.x} ${c.y + R - 4}C${c.x} ${c.y + R + 90} ${d.x.toFixed(1)} ${(d.y - 110).toFixed(1)} ${d.x.toFixed(1)} ${(d.y - d.s / 2).toFixed(1)}`
    : `M${c.x + R - 4} ${c.y}C${c.x + R + 130} ${c.y} ${(d.x - 150).toFixed(1)} ${d.y.toFixed(1)} ${(d.x - d.s / 2).toFixed(1)} ${d.y.toFixed(1)}`);
  return { W, H, c, R, gs, ms, inPaths, outPaths, vertical };
}
const views = [layout(false), layout(true)];
---
<div class="unity">
  {views.map((v) => (
    <svg class:list={['uni', v.vertical ? 'uni-v' : 'uni-h']} viewBox={`0 0 ${v.W} ${v.H}`} role="img" aria-label={label}>
      <defs>
        <symbol id={`ud-${v.vertical ? 'v' : 'h'}`} viewBox="4400 4150 12200 12700"><g fill="#CFB083">{dome.hearts.map((d) => <path d={d} />)}<path d={dome.finial} /></g></symbol>
        <radialGradient id={`ug-${v.vertical ? 'v' : 'h'}`}><stop offset="0" stop-color="#cfb083" stop-opacity="0.45" /><stop offset="1" stop-color="#cfb083" stop-opacity="0" /></radialGradient>
      </defs>
      <g class="threads">
        {v.inPaths.map((d) => <path d={d} pathLength="1" />)}
        {v.outPaths.map((d) => <path d={d} pathLength="1" class="out" />)}
      </g>
      <g class="particles">
        {v.inPaths.map((d, i) => <circle r="3.2" class="pt"><animateMotion dur="2.6s" begin={`${(i * 0.37) % 2.6}s`} repeatCount="indefinite" path={d} keyPoints="0;1" keyTimes="0;1" calcMode="spline" keySplines="0.5 0 0.4 1" /></circle>)}
        {v.outPaths.map((d, i) => <circle r="3.6" class="pt pt-out"><animateMotion dur="2.4s" begin={`${1.3 + ((i * 0.29) % 2.4)}s`} repeatCount="indefinite" path={d} keyPoints="0;1" keyTimes="0;1" calcMode="spline" keySplines="0.5 0 0.4 1" /></circle>)}
      </g>
      <g class="givers">
        {v.gs.map((g, i) => <path class="g" style={`--i:${i}`} d={heart} transform={`translate(${(g.x - 12 * g.s).toFixed(1)} ${(g.y - 12 * g.s).toFixed(1)}) scale(${g.s.toFixed(2)})`} />)}
      </g>
      <circle cx={v.c.x} cy={v.c.y} r={v.R * 2.1} fill={`url(#ug-${v.vertical ? 'v' : 'h'})`} class="aura" />
      <circle cx={v.c.x} cy={v.c.y} r={v.R} class="fund" />
      <circle cx={v.c.x} cy={v.c.y} r={v.R - 9} class="fund-ring" />
      <g transform={`translate(${v.c.x - 36} ${v.c.y - 38}) scale(3)`}><path class="fund-heart" d={heart} /></g>
      {v.ms.map((d, i) => <use class="m" style={`--i:${i}`} href={`#ud-${v.vertical ? 'v' : 'h'}`} x={d.x - d.s / 2} y={d.y - d.s / 2} width={d.s} height={d.s} />)}
      {v.vertical ? (
        <>
          <text x="200" y="20" class="lbl" text-anchor="middle">{givers}</text>
          <text x={v.c.x + v.R + 14} y={v.c.y - 4} class="lbl lbl-fund">{fund.split(' ').slice(0, -1).join(' ')}<tspan x={v.c.x + v.R + 14} dy="18">{fund.split(' ').slice(-1)[0]}</tspan></text>
          <text x="200" y="692" class="lbl" text-anchor="middle">{masajid}</text>
        </>
      ) : (
        <>
          <text x="115" y="436" class="lbl" text-anchor="middle">{givers}</text>
          <text x={v.c.x} y={v.c.y + v.R + 34} class="lbl lbl-fund" text-anchor="middle">{fund}</text>
          <text x="850" y="436" class="lbl" text-anchor="middle">{masajid}</text>
        </>
      )}
    </svg>
  ))}
</div>

<style>
  .unity { position: relative; }
  .uni { width: 100%; height: auto; overflow: visible; }
  .uni-v { display: none; max-width: 420px; margin-inline: auto; }
  @media (max-width: 700px) { .uni-h { display: none; } .uni-v { display: block; } }
  .threads path { fill: none; stroke: #cfb083; stroke-width: 1.1; opacity: 0.32; }
  .threads path.out { stroke-width: 1.4; opacity: 0.45; }
  .pt { fill: #e7d6b8; filter: drop-shadow(0 0 4px rgba(231, 214, 184, 0.9)); }
  .pt-out { fill: #fff3dc; }
  .g { fill: #cfb083; opacity: 0.85; }
  .fund { fill: #00332b; stroke: #cfb083; stroke-width: 1.6; }
  .fund-ring { fill: none; stroke: rgba(207, 176, 131, 0.35); stroke-width: 1; stroke-dasharray: 3 5; }
  .fund-heart { fill: #cfb083; transform-box: fill-box; transform-origin: center; }
  .lbl { fill: rgba(255, 255, 255, 0.72); font-family: var(--sans); font-size: 15px; font-weight: 650; letter-spacing: 0.14em; text-transform: uppercase; }
  .uni-v .lbl { font-size: 13px; }
  .lbl-fund { fill: #e7d6b8; }
  .m { transform-box: fill-box; transform-origin: 50% 100%; }
  @media (prefers-reduced-motion: reduce) { .particles { display: none; } }
  @media (prefers-reduced-motion: no-preference) {
    .fund-heart { animation: beat 2.6s ease-in-out infinite; }
    .aura { animation: aura 2.6s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
    .fund-ring { animation: spin 40s linear infinite; transform-box: fill-box; transform-origin: center; }
    :global(.js [data-reveal]) .threads path { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.4s cubic-bezier(0.5, 0, 0.2, 1) 0.2s; }
    :global(.js [data-reveal]) .threads path.out { transition-delay: 1s; }
    :global(.js [data-reveal].in) .threads path { stroke-dashoffset: 0; }
    :global(.js [data-reveal]) .m { opacity: 0; transform: translateY(8px) scale(0.7); transition: opacity 0.6s, transform 0.6s cubic-bezier(0.22, 0.8, 0.26, 1); transition-delay: calc(1.5s + var(--i) * 70ms); }
    :global(.js [data-reveal].in) .m { opacity: 1; transform: none; }
  }
  @keyframes beat { 0%, 100% { transform: scale(1); } 12% { transform: scale(1.1); } 24% { transform: scale(1); } 36% { transform: scale(1.06); } 48% { transform: scale(1); } }
  @keyframes aura { 0%, 100% { opacity: 0.7; } 20% { opacity: 1; } }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>
