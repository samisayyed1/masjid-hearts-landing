---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Dome from '../components/Dome.astro';
import Heart from '../components/Heart.astro';
import Arrow from '../components/Arrow.astro';
import Icon from '../components/Icon.astro';
import Media from '../components/Media.astro';
import SunMap from '../components/SunMap.astro';
import Unity from '../components/Unity.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import c from '../content/landing.json';
import masajidFile from '../content/masajid.json';
const masajid = masajidFile.masajid;
import projectsFile from '../content/projects.json';
const projects = projectsFile.projects;
import interior from '../assets/site/masjid-interior.jpg';
import { giveHref, count, fill } from '../lib/site';

const perDay = (amount: number) => {
  const d = (amount * 12) / 365;
  return d < 1 ? `${Math.round(d * 100)} cents` : `$${d.toFixed(2)}`;
};
const featured = projects.find((p) => p.featured) ?? projects[0];
const others = projects.filter((p) => p !== featured);
const tiers = c.tiers.items;
---

<Base>
  <!-- ============ HERO ============ -->
  <section class="hero dark" id="top" data-hero>
    <div class="pattern hero-pattern" aria-hidden="true"></div>
    <div class="rise" aria-hidden="true">{Array.from({ length: 14 }).map((_, i) => <span style={`--i:${i}`}><Heart /></span>)}</div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow hero-in" style="--d:0"><Heart /> {c.hero.eyebrow}</p>
        <h1 class="display h1">
          {c.hero.lines.map((l, i) => <span class="line hero-in" style={`--d:${i + 1}`}>{l}</span>)}
          <span class="line hero-in" style={`--d:${c.hero.lines.length + 1}`}><em>{c.hero.em}</em></span>
        </h1>
        <p class="lede hero-in" style="--d:4">{c.hero.sub}</p>
        <div class="hero-cta hero-in" style="--d:5">
          <a class="btn btn-gold" href="#tiers">{c.hero.cta} <Arrow /></a>
          <a class="btn btn-ghost" href="#impact">{c.hero.cta2}</a>
        </div>
      </div>
      <div class="hero-art">
        <svg class="halo-star" viewBox="0 0 200 200" aria-hidden="true"><g fill="none" stroke="#CFB083" stroke-width="0.6"><rect x="40" y="40" width="120" height="120" /><rect x="40" y="40" width="120" height="120" transform="rotate(45 100 100)" /><circle cx="100" cy="100" r="92" stroke-dasharray="1.5 4" /></g></svg>
        <div class="halo" aria-hidden="true"></div>
        <Dome />
      </div>
    </div>
    <div class="wrap">
      <ul class="facts" role="list">
        {c.hero.facts.map((f) => (
          <li>
            <strong class="display">{f.value === '{count}' ? <span data-count={count}>{count}</span> : f.value}</strong>
            <span>{f.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ STORY ============ -->
  <section class="section story" id="story">
    <div class="narrow hadith" data-reveal>
      <p class="eyebrow"><Heart /> {c.story.eyebrow}</p>
      <p class="ar hadith-ar" lang="ar">{c.story.arabic}</p>
      <blockquote class="display hadith-en">{c.story.quote}</blockquote>
      <p class="cite">— {c.story.source} <span>[{c.story.ref}]</span></p>
    </div>
    <div class="wrap story-grid">
      <div class="big-count" data-reveal>
        <span class="display num" data-count={count}>{count}</span>
        <span class="lbl">{c.story.countLabel}</span>
      </div>
      <div class="prose" data-reveal style="--d:1">
        <p>{c.story.p1}</p>
        <p class="inspired display">{c.story.inspired}</p>
        <p>{fill(c.story.p2)}</p>
      </div>
    </div>
  </section>

  <!-- ============ SUN / LIVE MAP ============ -->
  <section class="section sun dark" id="right-now">
    <div class="pattern" aria-hidden="true"></div>
    <div class="wrap">
      <div class="sun-head">
        <div data-reveal>
          <p class="eyebrow"><Heart /> {c.sun.eyebrow}</p>
          <h2 class="display h2">{c.sun.h2} <em>{c.sun.h2em}</em></h2>
        </div>
        <div class="prose" data-reveal style="--d:1">
          <p>{c.sun.p1}</p>
          <p>{c.sun.p2}</p>
        </div>
      </div>
      <div data-reveal><SunMap /></div>
      <div class="tagline" data-reveal>
        <p class="display">{c.sun.tagline} <em>{c.sun.taglineEm}</em></p>
        <div class="cta-row">
          <a class="btn btn-gold" href="#tiers">{c.hero.cta} <Arrow /></a>
          <a class="btn btn-ghost" href="#impact">{c.hero.cta2}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CENTERS OF LIGHT ============ -->
  <section class="section light sand" id="light">
    <div class="wrap light-grid">
      <div data-reveal>
        <p class="eyebrow"><Heart /> {c.light.eyebrow}</p>
        <h2 class="display h2">{c.light.h2} <em>{c.light.h2em}</em></h2>
        <figure class="ayah">
          <p class="ar" lang="ar">{c.light.arabic}</p>
          <blockquote>{c.light.quote}</blockquote>
          <figcaption>— {c.light.ref}</figcaption>
        </figure>
      </div>
      <div class="prose light-copy" data-reveal style="--d:1">
        <p>{c.light.p1}</p>
      </div>
    </div>

    <div class="wrap">
      <p class="roles display" data-reveal>
        {c.light.statement}{' '}
        {c.light.roles.map((r, i) => <><em style={`--d:${i}`}>{r}</em>{i < c.light.roles.length - 1 ? ', ' : ''}</>)}
      </p>
    </div>

    <div class="wrap wants-wrap">
      <p class="lede" data-reveal>{c.light.p2}</p>
      <ul class="wants" role="list">
        {c.light.wants.map((w, i) => (
          <li data-reveal style={`--d:${i}`}>
            <span class="ic"><Icon name={w.icon} /></span>
            <p>{w.text}</p>
          </li>
        ))}
      </ul>
      <div class="respect" data-reveal>
        <p class="display">{c.light.respect} <em>{c.light.respectEm}</em></p>
        <p class="lede">{c.light.p3}</p>
      </div>
    </div>

    <!-- Network carousel: replace the placeholders in src/content/masajid.json -->
    <div class="wrap network-head" data-reveal>
      <div>
        <p class="eyebrow"><Heart /> {c.light.networkEyebrow}</p>
        <h3 class="display h3">{c.light.networkH3}</h3>
      </div>
      <div class="arrows">
        <button type="button" class="round" data-scroll="-1" aria-label={c.light.prev}><Icon name="left" /></button>
        <button type="button" class="round" data-scroll="1" aria-label={c.light.next}><Icon name="right" /></button>
      </div>
    </div>
    <ul class="network" role="list" data-track tabindex="0" aria-label={c.light.networkH3}>
      {masajid.map((m) => (
        <li class="masjid">
          <div class="frame"><Media src={m.image} alt={m.imageAlt} label={m.name} sizes="(max-width: 760px) 78vw, 340px" /></div>
          <p class="m-tag">{m.initiative}</p>
          <h4>{m.name}</h4>
          <p class="m-place">{m.city}, {m.country}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- ============ MODEL ============ -->
  <section class="section model" id="model">
    <div class="wrap">
      <div class="model-head" data-reveal>
        <p class="eyebrow"><Heart /> {c.model.eyebrow}</p>
        <h2 class="display h2">{c.model.h2} <em>{c.model.h2em}</em></h2>
      </div>
      <div class="compare">
        <div class="cmp cmp-old" data-reveal>
          <p class="cmp-label">{c.model.oldLabel}</p>
          <div class="cmp-art" aria-hidden="true"><span class="one"><Icon name="hall" /></span></div>
          <p>{c.model.old}</p>
        </div>
        <div class="cmp-vs" aria-hidden="true"><Arrow /></div>
        <div class="cmp cmp-new" data-reveal style="--d:1">
          <p class="cmp-label">{c.model.newLabel}</p>
          <div class="cmp-art" aria-hidden="true">{Array.from({ length: 9 }).map(() => <span><Icon name="hall" /></span>)}</div>
          <p>{c.model.new}</p>
        </div>
      </div>
      <p class="lede model-lede" data-reveal>{c.model.p1}</p>
      <div class="unity-panel dark" data-reveal>
        <div class="pattern" aria-hidden="true"></div>
        <Unity label={c.model.diagram} givers={c.model.givers} fund={c.model.fund} masajid={fill(c.model.masajid)} />
      </div>
      <h3 class="month-label" data-reveal>{c.model.monthLabel}</h3>
      <ol class="month" role="list">
        {c.model.month.map((m, i) => (
          <li data-reveal style={`--d:${i}`}>
            <span class="ic"><Icon name={m.icon} /></span>
            <p class="place">{m.place}</p>
            <p>{m.text}</p>
          </li>
        ))}
      </ol>
      <p class="model-close display" data-reveal>{c.model.close}</p>
    </div>
  </section>

  <!-- ============ SADAQAH JARIYAH ============ -->
  <section class="jariyah dark" id="jariyah">
    <Image class="j-img" src={interior} alt="" widths={[640, 960, 1280, 1634]} sizes="100vw" loading="lazy" />
    <div class="j-shade" aria-hidden="true"></div>
    <div class="wrap j-inner section">
      <div class="j-head" data-reveal>
        <p class="eyebrow"><Heart /> {c.jariyah.eyebrow}</p>
        <h2 class="display h2">{c.jariyah.h2}</h2>
        <p class="ar j-ar" lang="ar">{c.jariyah.arabic}</p>
        <blockquote class="display j-quote">{c.jariyah.quote}</blockquote>
        <p class="cite">— {c.jariyah.ref}</p>
      </div>
      <div class="prose j-copy" data-reveal><p>{c.jariyah.p1}</p></div>
      <h3 class="j-label" data-reveal>{c.jariyah.rewardsLabel}</h3>
      <ul class="rewards" role="list">
        {c.jariyah.rewards.map((r, i) => (
          <li data-reveal style={`--d:${i}`}>
            <span class="ic"><Icon name={r.icon} /></span>
            <h4 class="display">{r.title}</h4>
            <p>{r.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ INITIATIVES ============ -->
  <section class="section initiatives" id="initiatives">
    <div class="wrap init-grid">
      <div class="init-head">
        <div data-reveal>
          <p class="eyebrow"><Heart /> {c.initiatives.eyebrow}</p>
          <h2 class="display h2">{c.initiatives.h2} <em>{c.initiatives.h2em}</em></h2>
          <p class="lede">{c.initiatives.lede}</p>
          <a class="btn btn-green" href="#tiers">{c.hero.cta} <Arrow /></a>
        </div>
      </div>
      <ol class="inits" role="list">
        {c.initiatives.items.map((it, i) => (
          <li data-reveal>
            <span class="num display">{String(i + 1).padStart(2, '0')}</span>
            <span class="ic"><Icon name={it.icon} /></span>
            <div>
              <p class="focus">{it.focus}{it.draft && <span class="ph-chip draft">Copy to confirm</span>}</p>
              <h3 class="display">{it.name}</h3>
              <p>{it.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ TIERS ============ -->
  <section class="section tiers mist" id="tiers" data-quiet>
    <div class="wrap">
      <div class="tiers-head" data-reveal>
        <p class="eyebrow"><Heart /> {c.tiers.eyebrow}</p>
        <h2 class="display h2">{c.tiers.h2} <em>{c.tiers.h2em}</em></h2>
        <p class="lede">{c.tiers.lede}</p>
      </div>
      <ul class="tier-list" role="list">
        {tiers.map((t, i) => (
          <li class:list={['tier', { top: i === tiers.length - 1 }]} data-reveal style={`--d:${i}`}>
            <div class="t-top">
              <span class="ic"><Icon name={t.icon} /></span>
              <span class="ar t-ar" lang="ar">{t.arabic}</span>
            </div>
            <h3 class="display">{t.name}</h3>
            <p class="t-sub">{t.arabicName}</p>
            <p class="price"><span class="display">${t.amount}</span> {c.tiers.perMonth}</p>
            {!/a day/i.test(t.tagline) && <p class="per-day">{c.tiers.perDay.replace('{d}', perDay(t.amount))}</p>}
            <p class="t-tag">{t.tagline}</p>
            <p class="t-text">{t.text}</p>
            <div class="t-impact"><p class="k">{c.tiers.impact}</p><p>{t.impact}</p></div>
            <a class:list={['btn', i === tiers.length - 1 ? 'btn-gold' : 'btn-green']} href={giveHref(t.amount, t.link)}>{c.tiers.button.replace('{amount}', String(t.amount))}</a>
          </li>
        ))}
      </ul>
      <form class="custom" data-reveal data-custom action={giveHref()} method="get">
        <div>
          <h3 class="display">{c.tiers.custom.name}</h3>
          <p>{c.tiers.custom.text}</p>
        </div>
        <label class="amount-field">
          <span class="sr">{c.tiers.custom.label}</span>
          <span class="cur" aria-hidden="true">$</span>
          <input type="number" inputmode="numeric" min="1" step="1" value="20" name="give" required />
          <span class="mo" aria-hidden="true">{c.tiers.perMonth}</span>
        </label>
        <button class="btn btn-green" type="submit">{c.tiers.custom.button} <Arrow /></button>
      </form>
    </div>
  </section>

  <!-- ============ PROMISE ============ -->
  <section class="section promise" id="promise">
    <div class="wrap">
      <div class="promise-head" data-reveal>
        <p class="eyebrow"><Heart /> {c.promise.eyebrow}</p>
        <h2 class="display h2">{c.promise.h2} <em>{c.promise.h2em}</em></h2>
        <p class="lede">{c.promise.lede}</p>
      </div>
      <ul class="promises" role="list">
        {c.promise.items.map((p, i) => (
          <li data-reveal style={`--d:${i}`}>
            <span class="ic"><Icon name={p.icon} /></span>
            <h3 class="display">{p.title}</h3>
            {p.sub && <p class="sub">{p.sub}</p>}
            <p>{p.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ IMPACT / PROOF ============ -->
  <section class="section impact dark" id="impact">
    <div class="pattern" aria-hidden="true"></div>
    <div class="wrap">
      <div class="impact-head" data-reveal>
        <p class="eyebrow"><Heart /> {c.impact.eyebrow}</p>
        <h2 class="display h2">{c.impact.h2} <em>{c.impact.h2em}</em></h2>
        <p class="lede">{c.impact.lede}</p>
      </div>
      <div class="feature" data-reveal>
        <BeforeAfter before={featured.before} after={featured.after} beforeAlt={featured.beforeAlt} afterAlt={featured.afterAlt} label={featured.title} beforeText={c.impact.before} afterText={c.impact.after} slider={c.impact.slider} />
        <div class="feature-body">
          {featured.placeholder && <span class="ph-chip">{c.placeholder}</span>}
          <p class="p-tag">{featured.initiative} · {featured.year}</p>
          <h3 class="display h3">{featured.title}</h3>
          <p class="p-where">{featured.masjid}, {featured.country}</p>
          <p class="p-sum">{featured.summary}</p>
        </div>
      </div>
      <h3 class="more" data-reveal>{c.impact.more}</h3>
      <ul class="projects" role="list">
        {others.map((p, i) => (
          <li data-reveal style={`--d:${i % 3}`}>
            <div class="frame"><Media src={p.after || p.before} alt={p.afterAlt || p.beforeAlt} label={p.title} tone="after" sizes="(max-width: 760px) 90vw, 380px" /></div>
            <p class="p-tag">{p.initiative} · {p.year}</p>
            <h4 class="display">{p.title}</h4>
            <p class="p-where">{p.masjid}, {p.country}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <section class="section final" id="join" data-quiet>
    <div class="final-glow" aria-hidden="true"></div>
    <div class="narrow final-inner">
      <div class="final-dome" data-reveal aria-hidden="true"><Dome /></div>
      <p class="eyebrow" data-reveal><Heart /> {c.final.eyebrow}</p>
      <h2 class="display h2" data-reveal>{c.final.h2} <em>{c.final.h2em}</em></h2>
      <div class="prose" data-reveal>
        <p>{c.final.p1}</p>
        <p>{c.final.p2}</p>
        <p class="urgent">{c.final.p3}</p>
      </div>
      <div class="final-cta" data-reveal>
        <a class="btn btn-gold btn-xl" href="#tiers">{c.final.cta} <Arrow /></a>
        <ul class="mini-tiers" role="list">
          {tiers.map((t) => <li><a href={giveHref(t.amount, t.link)}><strong>${t.amount}</strong> {t.name.replace('The ', '')}</a></li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>

<script>
  // Network carousel arrows.
  const track = document.querySelector<HTMLElement>('[data-track]');
  document.querySelectorAll<HTMLButtonElement>('[data-scroll]').forEach((b) => b.addEventListener('click', () => {
    if (!track) return;
    const card = track.querySelector<HTMLElement>('li');
    const step = card ? card.getBoundingClientRect().width + 20 : 320;
    track.scrollBy({ left: Number(b.dataset.scroll) * step * (innerWidth > 900 ? 2 : 1), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  }));

  // "Your own amount" goes to the same place as the other donate buttons, with the amount filled in.
  const form = document.querySelector<HTMLFormElement>('[data-custom]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const amount = Math.max(1, Math.round(Number(new FormData(form).get('give')) || 0));
    const target = new URL(form.action);
    target.searchParams.set('give', String(amount));
    location.href = target.href;
  });
</script>

<style>
  /* ---------- Hero ---------- */
  .hero { position: relative; padding: clamp(128px, 15vw, 184px) 0 0; overflow: hidden; background: radial-gradient(110% 90% at 80% 25%, #0b6150 0%, var(--green) 44%, var(--green-deep) 100%); }
  .hero-pattern { mask-image: linear-gradient(100deg, transparent 8%, #000 72%); -webkit-mask-image: linear-gradient(100deg, transparent 8%, #000 72%); }
  .hero-grid { position: relative; display: grid; grid-template-columns: 1.2fr 0.8fr; align-items: center; gap: clamp(24px, 5vw, 72px); }
  .hero-copy > * + * { margin-top: 26px; }
  .hero h1 { font-size: clamp(2.6rem, 5.5vw, 5rem); }
  .hero h1 .line { display: block; }
  .hero h1 em { color: var(--gold); }
  .hero-copy .lede { max-width: 52ch; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 38px; }
  .hero-art { position: relative; width: 100%; max-width: 470px; justify-self: center; }
  .halo { position: absolute; inset: -20%; border-radius: 50%; background: radial-gradient(closest-side, rgba(207, 176, 131, 0.26), transparent 70%); }
  .halo-star { position: absolute; inset: -22%; width: 144%; max-width: none; opacity: 0.5; }
  .hero-art :global(.dome) { position: relative; filter: drop-shadow(0 24px 40px rgba(0, 20, 16, 0.4)); }
  .facts { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); margin-top: clamp(64px, 9vw, 104px); border-top: 1px solid var(--line-light); }
  .facts li { padding: 28px 28px 36px 0; }
  .facts li + li { padding-left: 28px; border-left: 1px solid var(--line-light); }
  .facts strong { display: block; font-size: clamp(2rem, 3.4vw, 2.7rem); color: var(--gold-soft); line-height: 1; }
  .facts span:not([data-count]) { display: block; margin-top: 8px; color: rgba(255, 255, 255, 0.74); }
  .rise { position: absolute; inset: 0; pointer-events: none; }
  .rise span { position: absolute; bottom: -30px; left: calc(52% + var(--i) * 3.4%); width: calc(8px + (var(--i) * 7 % 9) * 1px); color: var(--gold); opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .rise span { animation: rise calc(9s + (var(--i) * 13 % 7) * 1s) linear infinite; animation-delay: calc(var(--i) * -1.3s); }
    .hero-in { opacity: 0; transform: translateY(18px); animation: in 0.9s var(--ease) forwards; animation-delay: calc(0.15s + var(--d) * 0.12s); }
    .halo-star { animation: turn 120s linear infinite; }
  }
  @keyframes rise { 0% { transform: translateY(0) rotate(0); opacity: 0; } 12% { opacity: 0.55; } 80% { opacity: 0.25; } 100% { transform: translateY(-105vh) rotate(25deg); opacity: 0; } }
  @keyframes in { to { opacity: 1; transform: none; } }
  @keyframes turn { to { transform: rotate(360deg); } }
  @media (max-width: 900px) {
    .hero { padding-top: 104px; }
    .hero-grid { grid-template-columns: 1fr; gap: 18px; }
    .hero-art { order: -1; max-width: min(48vw, 210px); justify-self: start; margin-bottom: 8px; }
    .hero-copy > * + * { margin-top: 20px; }
    .hero-cta .btn { flex: 1 1 100%; }
    .facts { grid-template-columns: 1fr; margin-top: 48px; }
    .facts li, .facts li + li { padding: 20px 0; border-left: 0; display: grid; grid-template-columns: 96px 1fr; align-items: center; gap: 14px; }
    .facts li + li { border-top: 1px solid var(--line-light); }
    .facts span:not([data-count]) { margin-top: 0; }
    .rise span { left: calc(8% + var(--i) * 6.5%); }
  }
  @media (max-width: 380px) { .hero-cta .btn { white-space: normal; text-align: center; line-height: 1.25; padding-block: 10px; } }

  /* ---------- Story ---------- */
  .hadith { text-align: center; }
  .hadith-ar { margin-top: 28px; font-size: clamp(2.4rem, 6.4vw, 4.8rem); line-height: 1.6; color: var(--green); }
  .hadith-en { margin-top: 10px; font-size: clamp(1.5rem, 2.8vw, 2.2rem); font-style: italic; font-weight: 500; color: var(--ink); }
  .cite { margin-top: 18px; font-weight: 650; color: var(--gold-ink); }
  .cite span { font-weight: 500; color: var(--ink-soft); }
  .dark .cite { color: var(--gold-soft); }
  .dark .cite span { color: rgba(255, 255, 255, 0.7); }
